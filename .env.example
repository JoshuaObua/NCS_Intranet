CI_ENVIRONMENT = development
database.hostname = 127.0.0.1
database.port = 5432
database.database = ncs_db
database.username = ncs_user
database.password = change-me
database.driver = Postgre
database.prefix = ncs_
app.encryption_key = generate-a-long-random-secret

# ====================================================================
# NITA-U UG Pass (DAES) Integration Credentials
# Specification: Token API & OIDC Specification V1.5
# ====================================================================
# Environment: 'staging' (https://stgapi.ugpass.go.ug/idp/) or 'production' (https://api.ugpass.go.ug/idp/)
UGPASS_ENVIRONMENT = staging

# Client ID provided by NITA-U DAES platform upon Service Provider registration
UGPASS_CLIENT_ID = 

# Private Key (RS256 PEM string or absolute/relative file path to .pem file)
# Used to sign the client assertion JWT and authorization request JWT
UGPASS_PRIVATE_KEY = 
UGPASS_PRIVATE_KEY_PATH = 

# Optional Client Secret or passphrase if private key is encrypted
UGPASS_CLIENT_SECRET = 

# Public Key (optional: used for verifying ID tokens locally or via JWKS)
UGPASS_PUBLIC_KEY = 
UGPASS_PUBLIC_KEY_PATH = 

# Base URL override (Leave empty to use official NITA-U staging/production defaults)
# Staging: https://stgapi.ugpass.go.ug/idp/
# Production: https://api.ugpass.go.ug/idp/
UGPASS_BASE_URL = 

# Redirect URIs (Leave empty to use automatic {base_url}/ugpass/callback)
UGPASS_REDIRECT_URI = 
UGPASS_LOGOUT_REDIRECT_URI = 

# OIDC Scopes (Default: openid urn:idp:digitalid:profile)
UGPASS_SCOPES = "openid urn:idp:digitalid:profile"

# User Management: Auto-provision intranet staff accounts if not found by SUID/email/NIN
UGPASS_AUTO_CREATE_USER = true
UGPASS_DEFAULT_USER_TYPE = staff

# SSL Verification (Set to false only in offline development if CA certs fail)
UGPASS_VERIFY_SSL = true

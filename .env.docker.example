# Production settings for docker-compose.yml.
# Copy to .env on the server (never commit it) and fill in every value.
# Generate secrets with:  openssl rand -hex 32

DOMAIN=ncsintranet.atenimedia.com
CI_ENVIRONMENT=production

# Database (PostgreSQL container; not reachable from outside Docker)
DB_NAME=ncs_db
# Keep ncs_user: database_schema.sql grants privileges to this role by name.
DB_USER=ncs_user
DB_PASSWORD=
POSTGRES_SUPERUSER_PASSWORD=

# CodeIgniter encryption key
APP_ENCRYPTION_KEY=

# Initial administrator - only used the first time the database is created.
# Sign in with these, then change the password in the app.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# NITA-U UG Pass (optional). Key files can be placed in writable/ and referenced by path.
UGPASS_ENVIRONMENT=staging
UGPASS_CLIENT_ID=
UGPASS_PRIVATE_KEY_PATH=
UGPASS_CLIENT_SECRET=
UGPASS_PUBLIC_KEY_PATH=
UGPASS_BASE_URL=
UGPASS_REDIRECT_URI=
UGPASS_LOGOUT_REDIRECT_URI=
UGPASS_AUTO_CREATE_USER=true
UGPASS_DEFAULT_USER_TYPE=staff
UGPASS_VERIFY_SSL=true

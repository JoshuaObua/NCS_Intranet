@@ -0,0 +1,23 @@
+package repository
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/atenimedia-llc/ncs-online/backend/internal/models"
+	"github.com/google/uuid"
+)
+
+// AuditEventParams adapts the VPS operator UI events to the shared audit store.
+type AuditEventParams struct{ ActorID, ActorEmail, Action, Resource, Details, IPAddress string }
+
+func (r *OperatorRepo) LogAuditEvent(ctx context.Context, event AuditEventParams) error {
+	details, err := json.Marshal(map[string]string{"details": event.Details})
+	if err != nil {
+		return err
+	}
+	var userID *string
+	if event.ActorID != "" {
+		userID = &event.ActorID
+	}
+	return (&AuditRepo{db: r.db}).Log(ctx, &models.AuditLog{ID: uuid.NewString(), UserID: userID, Username: event.ActorEmail, Action: event.Action, Resource: event.Resource, NewValues: details, IPAddress: event.IPAddress, Authenticated: userID != nil})
+}
